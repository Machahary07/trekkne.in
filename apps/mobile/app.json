{
  "expo": {
    "name": "Trekne",
    "slug": "trekne",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "trekne",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "in.trekne.app",
      "infoPlist": {
        "NSMotionUsageDescription": "Trekne uses motion sensors to guide 360 captures."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFC21A",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "in.trekne.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FF6A2B",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160,
          "dark": {
            "backgroundColor": "#0C0F17",
            "image": "./assets/images/splash-icon.png"
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Trekne uses the camera for field reports and 360 views of current conditions.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Trekne tags field reports with where they were filed."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Trekne uses the camera for field report photos.",
          "photosPermission": false
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "Trekne uses motion sensors to guide 360 captures."
        }
      ],
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "38dacdeb-9060-4dd3-9440-4faba4fee96f"
      }
    },
    "owner": "vxwshxl"
  }
}
